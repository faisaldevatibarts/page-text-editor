{
  "manifest_version": 3,
  "name": "Page Editor",
  "version": "2.0.0",
  "description": "Select any element on any website to edit its text, replace images, duplicate, move, restyle or delete it. Changes are temporary (until reload).",
  "permissions": ["activeTab", "scripting"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Toggle Page Editor",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+E" },
      "description": "Toggle Page Editor"
    }
  }
}
